# Copy to .env for local runs. Never commit .env or real tokens.
PORT=8787
HOST=127.0.0.1

# Facility catalog. Default is the committed fictional sample.
# Point this at backend/data/facilities.json after an Airtable import.
FACILITIES_PATH=backend/data/facilities.example.json

# Read path is merged with the example cache. New lookups are written to the
# gitignored local cache, not the example file.
GEOCODE_CACHE_PATH=backend/data/geocode-cache.example.json
GEOCODE_WRITE_PATH=backend/data/geocode-cache.json

# cache = local JSON only (works offline for the sample addresses)
# nominatim = also call OpenStreetMap Nominatim once per unknown address
GEOCODER=cache
NOMINATIM_EMAIL=
NOMINATIM_MIN_INTERVAL_MS=1100

AVAILABILITY_PROVIDER=mock
AVAILABILITY_TTL_MS=30000
AVAILABILITY_DELAY_MS=120
NEARBY_LIMIT=5

# Airtable import (npm run import:airtable). Leave blank in git.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=Facilities
AIRTABLE_VIEW=
AIRTABLE_FIELD_NAME=Name
AIRTABLE_FIELD_ADDRESS=Address
AIRTABLE_FIELD_LAT=Latitude
AIRTABLE_FIELD_LNG=Longitude
AIRTABLE_FIELD_STALLS=Stalls
AIRTABLE_FIELD_HOURS=Hours
AIRTABLE_FIELD_NOTES=Notes
AIRTABLE_FIELD_MANAGED=Managed
IMPORT_OUTPUT=backend/data/facilities.json
