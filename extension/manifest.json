{
  "manifest_version": 3,
  "name": "Nearby Relocation",
  "version": "0.1.0",
  "description": "Shows nearby managed parking facilities for the open Beetexting conversation.",
  "minimum_chrome_version": "114",
  "permissions": ["storage", "sidePanel", "clipboardWrite"],
  "host_permissions": [
    "https://app.beetexting.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_title": "Nearby relocation spots",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "panel/panel.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.beetexting.com/*",
        "http://127.0.0.1:4173/*",
        "http://localhost:4173/*"
      ],
      "js": ["lib/defaults.js", "lib/extract.js", "content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["panel/*", "lib/*", "icons/*"],
      "matches": [
        "https://app.beetexting.com/*",
        "http://127.0.0.1:4173/*",
        "http://localhost:4173/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
